# Normalize line endings across platforms.
# Without this, files authored on Windows can land in the repo with CRLF,
# which leaks into shell pipelines (e.g., `grep version: SKILL.md | sed ...`
# captures the trailing \r and breaks downstream path operations like
# install_skill.py's cache dir naming).

* text=auto eol=lf

# Lock specific text formats to LF regardless of platform.
*.md   text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.feature text eol=lf

# Windows-only file types — keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary (do not normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.gz  binary
*.tar binary
*.ico binary
*.woff  binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.webm binary
